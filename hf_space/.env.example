# Copy to .env for local dev, or set as Space secrets. Never commit real values.
HF_TOKEN=            # write access to the private dataset mpily/bantugrammar-feedback
PHONE_HASH_SALT=     # long random string; changing it breaks continuity of hashed ids
AT_USERNAME=sandbox
AT_API_KEY=          # Africa's Talking sandbox API key
AT_SENDER_ID=        # optional short code / sender id
AT_WEBHOOK_TOKEN=    # optional; if set, AT callback URLs must end with ?token=<value>
TRUSTED_REVIEWER_KEYS=  # comma-separated keys for X-Reviewer-Key (trusted reviewer approval)
